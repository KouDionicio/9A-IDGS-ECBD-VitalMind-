NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=vitalmind_app
MYSQL_SKIP_CREATE_DATABASE=false
MYSQL_CONNECT_TIMEOUT_MS=5000

GEMINI_API_KEY=

# Opcional. La inicialización crea esquema sin datos demo por defecto.
SEED_DEMO_DATA=false
SEED_ADMIN_PASSWORD=replace_with_a_demo_admin_password
SEED_PATIENT_PASSWORD=replace_with_a_demo_patient_password
